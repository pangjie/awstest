#!/bin/bash
set -euo pipefail

dnf install -y docker jq
systemctl enable --now docker

install -d -m 700 /opt/aws-miniflow
install -d -m 755 /opt/aws
curl --fail --silent --show-error \
  --output /opt/aws/rds-ca-bundle.pem \
  https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
chmod 644 /opt/aws/rds-ca-bundle.pem

cat > /usr/local/bin/deploy-miniflow <<'DEPLOY_SCRIPT'
#!/bin/bash
set -euo pipefail

AWS_REGION='${aws_region}'
ECR_REGISTRY='${ecr_registry}'
DATABASE_SECRET_ARN='${database_secret_arn}'
DATABASE_HOST='${database_host}'
DATABASE_PORT='${database_port}'
DATABASE_NAME='${database_name}'
ENV_FILE='/opt/aws-miniflow/runtime.env'
CONTAINER_NAME='aws-miniflow'
IMAGE_URI="$${1:?usage: deploy-miniflow IMAGE_URI}"

if [[ "$${IMAGE_URI}" != "$${ECR_REGISTRY}/"* ]]; then
  echo 'Refusing an image outside the project AWS account and Region.' >&2
  exit 2
fi

SECRET_JSON="$$(aws secretsmanager get-secret-value \
  --region "$${AWS_REGION}" \
  --secret-id "$${DATABASE_SECRET_ARN}" \
  --query SecretString \
  --output text)"

DB_USER="$$(jq -er '.username' <<<"$${SECRET_JSON}")"
DB_PASSWORD="$$(jq -er '.password' <<<"$${SECRET_JSON}")"

umask 077
{
  printf 'NODE_ENV=production\n'
  printf 'PORT=3000\n'
  printf 'DB_HOST=%s\n' "$${DATABASE_HOST}"
  printf 'DB_PORT=%s\n' "$${DATABASE_PORT}"
  printf 'DB_NAME=%s\n' "$${DATABASE_NAME}"
  printf 'DB_USER=%s\n' "$${DB_USER}"
  printf 'DB_PASSWORD=%s\n' "$${DB_PASSWORD}"
  printf 'DB_SSL=verify-full\n'
  printf 'DB_CA_PATH=/opt/aws/rds-ca-bundle.pem\n'
} > "$${ENV_FILE}"

aws ecr get-login-password --region "$${AWS_REGION}" \
  | docker login --username AWS --password-stdin "$${ECR_REGISTRY}"
docker pull "$${IMAGE_URI}"

PREVIOUS_IMAGE=''
if docker inspect "$${CONTAINER_NAME}" >/dev/null 2>&1; then
  PREVIOUS_IMAGE="$$(docker inspect --format '{{.Config.Image}}' "$${CONTAINER_NAME}")"
  docker rm --force "$${CONTAINER_NAME}"
fi

run_container() {
  local image="$${1}"
  docker run --detach \
    --name "$${CONTAINER_NAME}" \
    --restart unless-stopped \
    --env-file "$${ENV_FILE}" \
    --volume /opt/aws/rds-ca-bundle.pem:/opt/aws/rds-ca-bundle.pem:ro \
    --publish 80:3000 \
    --security-opt no-new-privileges:true \
    --cap-drop ALL \
    "$${image}"
}

run_container "$${IMAGE_URI}"

READY=false
for attempt in $$(seq 1 30); do
  if curl --fail --silent http://127.0.0.1/health/ready >/dev/null; then
    READY=true
    break
  fi
  sleep 2
done

if [[ "$${READY}" != 'true' ]]; then
  echo 'New container failed readiness; collecting logs and rolling back.' >&2
  docker logs --tail 200 "$${CONTAINER_NAME}" >&2 || true
  docker rm --force "$${CONTAINER_NAME}" || true
  if [[ -n "$${PREVIOUS_IMAGE}" ]]; then
    run_container "$${PREVIOUS_IMAGE}"
    echo "Rolled back to $${PREVIOUS_IMAGE}" >&2
  fi
  exit 1
fi

docker image prune --force --filter 'until=168h' >/dev/null
echo "Deployment healthy: $${IMAGE_URI}"
DEPLOY_SCRIPT

chmod 750 /usr/local/bin/deploy-miniflow
