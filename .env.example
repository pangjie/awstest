NODE_ENV=development
DATABASE_URL=postgres://app:app@localhost:5432/miniflow
INITIAL_ADMIN_USERNAME=admin
# Local development only. Production initial credentials are stored in AWS Secrets Manager.
INITIAL_ADMIN_PASSWORD=
# Production only. Use verify-full with the AWS RDS CA bundle.
DB_SSL=disable
DB_CA_PATH=/opt/aws/rds-ca-bundle.pem
